# 服务模式配置。库模式不需要任何环境变量。
# 需要 L2 结构化摘要时才配下面三个；不配会自动降级为 L1/L3，并在响应里标注 summaryDisabled。

LLM_BASE_URL=https://your-endpoint.example.com
LLM_API_KEY=YOUR_KEY_HERE
LLM_MODEL=YOUR_MODEL_NAME

# 1 = 启用 L2 摘要（需要上面三项齐全）
SUMMARY_ENABLED=0

# 服务端口（不要用 3000/3001/8000/8001/8088/8089）
PORT=8787

# 归档持久化路径，不填则只在内存
ARCHIVE_FILE=
